{
  "name": "railcontrol",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Railway service control POC",
  "main": "server/src/main.ts",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run ui\"",
    "server": "nest start --watch",
    "server:debug": "nest start --debug --watch",
    "ui": "vite --config ui/vite.config.ts",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "nest build",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/server/src/main",
    "test": "jest",
    "format": "prettier --write \"server/src/**/*.{ts,tsx}\" \"ui/**/*.{ts,tsx,js,css}\"",
    "format:check": "prettier --check \"server/src/**/*.{ts,tsx}\" \"ui/**/*.{ts,tsx,js,css}\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/serve-static": "^4.0.2",
    "axios": "^1.7.7",
    "helmet": "^8.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.15",
    "ts-jest": "^29.2.5",
    "typescript": "6.0.3",
    "vite": "^5.4.10"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "roots": ["<rootDir>/server/src"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}
