PORT=3000
CORS_ORIGIN=http://localhost:5173

# Railway GraphQL API credentials. These stay on the server.
RAILWAY_API_URL=https://backboard.railway.com/graphql/v2

# Configure exactly one token:
# - Account/workspace token: RAILWAY_API_TOKEN
# - Project token: RAILWAY_TOKEN
RAILWAY_API_TOKEN=
RAILWAY_TOKEN=
TARGET_RAILWAY_SERVICE_ID=
TARGET_RAILWAY_ENVIRONMENT_ID=
